# T3 Custom runs locally without a T3 Connect account.
# Cloud settings stay empty; provider authentication is configured in the app.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
T3CODE_RELAY_URL=

# Desktop updates must keep the custom UI and isolated application data.
T3CODE_DESKTOP_UPDATE_REPOSITORY=andongmin94/t3-custom
